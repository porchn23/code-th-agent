{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thai Agentic",
  "version": "0.1.0",
  "identifier": "com.porchn.thaiagentic",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Thai Agentic",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Compounding AI agent",
    "longDescription": "AI agent framework ที่สะสมความฉลาดข้ามรอบ — LLM + tools + playbook + skill library + evals",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
